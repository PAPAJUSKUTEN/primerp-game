# Skopiuj ten plik jako .env (lokalnie) albo wklej te zmienne w panelu Railway/Render (sekcja Variables)

# Z Discord Developer Portal -> Twoja aplikacja -> OAuth2 -> Client ID / Client Secret
DISCORD_CLIENT_ID=wklej_tutaj_client_id
DISCORD_CLIENT_SECRET=wklej_tutaj_client_secret

# Musi DOKŁADNIE pasować do Redirectu dodanego w Discord Developer Portal
# Lokalnie:  http://localhost:3000/auth/discord/callback
# Na Railway/Render (po wdrożeniu): https://twoja-aplikacja.up.railway.app/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Dowolny losowy, długi ciąg znaków (sekret sesji) — nie udostępniaj go nikomu
SESSION_SECRET=zmien-to-na-cos-losowego-i-dlugiego

PORT=3000
